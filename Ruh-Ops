function renderCfTable(){
  const tb=g('cf-tbody');if(!tb)return;
  const dir=v('cf-fdir'),sec=v('cf-fsec');
  const rows=allData.competitors.filter(r=>(!dir||r.dir===dir)&&(!sec||r.sector===sec));
  // Build alerts
  const al=g('cf-alert-list');
  if(al){
    let alerts='';
    rows.forEach(r=>{
      if(!r.pia)return;
      const cheap=[{n:'Saudia',v:r.sv},{n:'Flynas',v:r.xq},{n:'Flyadeal',v:r.f3},{n:'Airblue',v:r.pa},{n:'AirSial',v:r.airsial},{n:'Fly Jinnah',v:r.p9}].filter(c=>c.v&&c.v<r.pia);
      if(cheap.length)alerts+=`<div class="alert a-warn">⚠ ${r.date} ${r.dir==='OB'?'RUH→'+r.sector:r.sector+'→RUH'}: ${cheap.map(c=>c.n+' SAR '+c.v.toFixed(0)).join(', ')} cheaper than PIA (SAR ${r.pia.toFixed(0)})</div>`;
    });
    al.innerHTML=alerts||'<div class="alert a-success">✅ No undercut alerts for current filter</div>';
  }
  if(!rows.length){tb.innerHTML='<tr><td colspan="13" class="empty-state">No records</td></tr>';return}
  tb.innerHTML=rows.map(r=>{
    const fares=[{n:'PIA',v:r.pia},{n:'Saudia',v:r.sv},{n:'Flynas',v:r.xq},{n:'Flyadeal',v:r.f3},{n:'Airblue',v:r.pa},{n:'AirSial',v:r.airsial},{n:'Fly Jinnah',v:r.p9}].filter(f=>f.v);
    const cheapest=fares.length?fares.reduce((a,b)=>a.v<b.v?a:b):null;
    return`<tr>
      <td class="num">${r.date}</td>
      <td><span class="badge b-gray" style="font-family:var(--mono)">${r.by||'—'}</span></td>
