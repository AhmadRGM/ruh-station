function populateAnSectors(){
  const sel=g('an-sector');if(!sel)return;const cur=sel.value;
  sel.innerHTML='<option value="">All Sectors</option>';
  [...new Set([...allData.flightecon.map(r=>r.sector),...allData.competitors.map(r=>r.sector)])].forEach(s=>sel.appendChild(new Option(s,s)));
