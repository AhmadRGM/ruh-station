const CONFIG_KEY='ruh_fb_config';
const ADMIN_ID='ruhuupk';

let db,currentUser=null,currentRole=null,currentPerms={};
let allData={finance:[],flightecon:[],competitors:[],tasks:[]};
let usersMap={};
let dashCharts={},anChart=null;

function getConfig(){try{return JSON.parse(localStorage.getItem(CONFIG_KEY))}catch{return null}}
function saveFirebaseConfig(){
