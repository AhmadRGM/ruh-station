function ensureAdminUser(){
  db.ref('users/'+ADMIN_ID).once('value').then(function(snap){
    if(!snap.val()){
      var pass=prompt('FIRST TIME SETUP\nSet a password for admin account ('+ADMIN_ID+'):\nMinimum 6 characters:');
      if(!pass||pass.length<6){alert('Password must be at least 6 characters. Please refresh and try again.');hide('loading');show('auth-screen');return;}
      var pwHash=simpleHash(pass);
      db.ref('users/'+ADMIN_ID).set({
        uid:ADMIN_ID,name:'Station Manager',role:'admin',pwHash:pwHash,
        perms:{finance:true,flightecon:true,competitors:true,tasks:true},
        active:true,createdAt:nowISO()
      }).then(function(){
        alert('Admin account created!\nLogin ID: '+ADMIN_ID+'\nUse the password you just set.');
        hide('loading');show('auth-screen');
      }).catch(function(e){alert('Error: '+e.message);hide('loading');show('auth-screen');});
    } else {
      hide('loading');show('auth-screen');
    }
  }).catch(function(e){
    console.error('Firebase error:',e);
    hide('loading');
    // Show error in auth screen
    document.getElementById('setup-screen').style.display='flex';
    alert('Could not connect to Firebase. Check your configuration.\nError: '+e.message);
  });
}

// ═══════════════════════════════════════════════
// BOOT
// ═══════════════════════════════════════════════
window.onload=function(){
  if(!initFirebase())return;
  initSectors();
  db.ref('.info/connected').on('value',snap=>{
    const connected=snap.val()===true;
    if(g('sync-dot')){g('sync-dot').className='sync-dot'+(connected?'':' offline');g('sync-label').textContent=connected?'Live sync':'Offline'}
  });
  ensureAdminUser();
};
</script>
</body>
