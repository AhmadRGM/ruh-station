// FINANCE
// ═══════════════════════════════════════════════
function calcFin(){
  const sales=n('f-bsp')+n('f-counter')+n('f-va')+n('f-cargo')+n('f-dip')+n('f-ebt')+n('f-misc-sale');
  const exp=n('f-rac')+n('f-gaca')+n('f-swiss')+n('f-fuel')+n('f-sal')+n('f-util')+n('f-misc-exp');
  const pnl=sales-exp;
  g('f-ts').textContent='SAR '+sales.toFixed(2);
  g('f-te').textContent='SAR '+exp.toFixed(2);
  const pe=g('f-pnl');
  pe.textContent='SAR '+(pnl>=0?'+':'')+pnl.toFixed(2);
  pe.style.color=pnl>=0?'var(--success)':'var(--danger)';
  return{sales,exp,pnl};
}

function saveFin(){
  const t=calcFin();
  const rec={
    period:v('fin-period'),remarks:v('fin-remarks'),
    bsp:n('f-bsp'),counter:n('f-counter'),va:n('f-va'),cargo:n('f-cargo'),
    dip:n('f-dip'),ebt:n('f-ebt'),miscSale:n('f-misc-sale'),
    rac:n('f-rac'),gaca:n('f-gaca'),swiss:n('f-swiss'),fuel:n('f-fuel'),
    sal:n('f-sal'),util:n('f-util'),miscExp:n('f-misc-exp'),
    totalSales:t.sales,totalExp:t.exp,pnl:t.pnl,
    by:currentUser,createdAt:nowISO()
  };
  db.ref('finance').push(rec).then(()=>toast('✅ Finance record saved')).catch(e=>toast('❌ '+e.message,'err'));
  clrFin();
}

function clrFin(){
  ['f-bsp','f-counter','f-va','f-cargo','f-dip','f-ebt','f-misc-sale','f-rac','f-gaca','f-swiss','f-fuel','f-sal','f-util','f-misc-exp','fin-remarks'].forEach(id=>g(id)&&(g(id).value=''));
  calcFin();
}

