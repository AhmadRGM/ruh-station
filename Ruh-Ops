function runAnalysis(){
  if(!g('page-analysis').classList.contains('active'))return;
  const type=v('an-type'),sec=v('an-sector');
  const canvas=g('anChart');if(!canvas)return;
  if(anChart){anChart.destroy();anChart=null;}
  const sum=g('an-summary');

  if(type==='fin-trend'){
    const rows=[...allData.finance].sort((a,b)=>a.period>b.period?1:-1);
    anChart=new Chart(canvas,{type:'line',
      data:{labels:rows.map(r=>r.period||'?'),datasets:[
        {label:'Sales',data:rows.map(r=>r.totalSales||0),borderColor:'#0077b6',backgroundColor:'rgba(0,119,182,.1)',fill:true,tension:.4},
        {label:'Expenses',data:rows.map(r=>r.totalExp||0),borderColor:'#e74c3c',backgroundColor:'rgba(231,76,60,.08)',fill:true,tension:.4},
        {label:'P&L',data:rows.map(r=>r.pnl||0),borderColor:'#2ecc71',borderDash:[5,5],tension:.4}
      ]},
      options:{responsive:true,maintainAspectRatio:false,scales:{y:{ticks:{callback:v=>'SAR '+v.toLocaleString()}}}}});
    sum.innerHTML=rows.length?`<b>${rows.length}</b> period(s). Avg monthly P&L: <b>SAR ${(rows.reduce((a,r)=>a+(r.pnl||0),0)/rows.length).toFixed(0)}</b>`:'No data.';
  }
  else if(type==='sector-fare'){
    const rows=allData.flightecon.filter(r=>!sec||r.sector===sec);
    const map={};rows.forEach(r=>{if(!map[r.sector])map[r.sector]=[];map[r.sector].push(r.fare||0)});
    const labels=Object.keys(map);const avgs=labels.map(s=>avg(map[s]));
    anChart=new Chart(canvas,{type:'bar',
      data:{labels,datasets:[{label:'Avg Fare (SAR)',data:avgs.map(v=>+v.toFixed(2)),backgroundColor:'#0077b6',borderRadius:5}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});
    sum.innerHTML=labels.map((l,i)=>`<b>${l}</b>: SAR ${avgs[i].toFixed(0)}`).join(' &nbsp;|&nbsp; ')||'No data.';
  }
  else if(type==='voc-noc'){
    const rows=allData.flightecon.filter(r=>!sec||r.sector===sec);
    const map={};rows.forEach(r=>{if(!map[r.sector])map[r.sector]={voc:[],doc:[],noc:[]};map[r.sector].voc.push(r.voc||0);map[r.sector].doc.push(r.doc||0);map[r.sector].noc.push(r.noc||0)});
    const labels=Object.keys(map);
    anChart=new Chart(canvas,{type:'bar',
      data:{labels,datasets:[
        {label:'VOC',data:labels.map(s=>+avg(map[s].voc).toFixed(2)),backgroundColor:'#0077b6',borderRadius:4},
        {label:'DOC',data:labels.map(s=>+avg(map[s].doc).toFixed(2)),backgroundColor:'#e67e22',borderRadius:4},
        {label:'NOC',data:labels.map(s=>+avg(map[s].noc).toFixed(2)),backgroundColor:'#2ecc71',borderRadius:4}
      ]},
      options:{responsive:true,maintainAspectRatio:false,scales:{y:{ticks:{callback:v=>(v>=0?'+':'')+v}}}}});
    sum.innerHTML=labels.length?`Positive NOC = profitable sector. Sectors: <b>${labels.join(', ')}</b>`:'No data.';
  }
  else if(type==='comp-fare'){
    const rows=allData.competitors.filter(r=>!sec||r.sector===sec);
    const keys=['pia','sv','xq','f3','pa','airsial','p9'];
    const names=['PIA','Saudia','Flynas','Flyadeal','Airblue','AirSial','Fly Jinnah'];
    const colors=['#003f7f','#006428','#c0392b','#8e44ad','#e67e22','#2980b9','#16a085'];
    const avgs=keys.map(k=>{const vals=rows.filter(r=>r[k]).map(r=>r[k]);return vals.length?avg(vals):0});
    anChart=new Chart(canvas,{type:'bar',
      data:{labels:names,datasets:[{label:'Avg Fare (SAR)',data:avgs.map(v=>+v.toFixed(0)),backgroundColor:colors,borderRadius:5}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});
    const piaAvg=avgs[0];const compMin=Math.min(...avgs.slice(1).filter(v=>v>0));
    sum.innerHTML=`PIA avg: <b>SAR ${piaAvg.toFixed(0)}</b>. Cheapest competitor avg: <b>SAR ${compMin.toFixed(0)}</b>. ${compMin<piaAvg?'⚠ Competitors undercutting PIA.':'✅ PIA is most competitive.'}`;
  }
  else if(type==='pnl-breakdown'){
    const rows=[...allData.finance].sort((a,b)=>a.period>b.period?1:-1);
    anChart=new Chart(canvas,{type:'bar',
      data:{labels:rows.map(r=>r.period||'?'),datasets:[
        {label:'Sales',data:rows.map(r=>r.totalSales||0),backgroundColor:'rgba(0,119,182,.7)',borderRadius:3},
        {label:'Expenses',data:rows.map(r=>-(r.totalExp||0)),backgroundColor:'rgba(231,76,60,.7)',borderRadius:3}
      ]},
      options:{responsive:true,maintainAspectRatio:false,
        scales:{y:{ticks:{callback:v=>'SAR '+(v<0?'-':'')+Math.abs(v).toLocaleString()},stacked:false}},
        plugins:{tooltip:{callbacks:{label:ctx=>'SAR '+Math.abs(ctx.raw).toLocaleString()}}}}});
    sum.innerHTML=rows.length?`Finance P&L across <b>${rows.length}</b> period(s). Total net: <b>SAR ${rows.reduce((a,r)=>a+(r.pnl||0),0).toFixed(0)}</b>`:'No data.';
  }
}

