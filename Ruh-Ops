function saveUser(){
  const uid=v('u-id').trim().toLowerCase();
  const pass=v('u-pass').trim();
  const name=v('u-name').trim();
  if(!uid){toast('User ID is required','err');return;}
  if(!pass||pass.length<6){toast('Password must be at least 6 characters','err');return;}
  const role=v('u-role');
  const perms=role==='admin'
    ?{finance:true,flightecon:true,competitors:true,tasks:true}
    :{finance:g('up-finance').checked,flightecon:g('up-flightecon').checked,
      competitors:g('up-competitors').checked,tasks:g('up-tasks').checked};
  // Store a simple hash of the password (not cryptographic — for lightweight auth only)
  const pwHash=simpleHash(pass);
  const userData={uid,name,role,perms,pwHash,active:true,createdBy:currentUser,createdAt:nowISO()};
  db.ref('users/'+uid).set(userData)
    .then(()=>{toast('✅ User '+uid+' saved');clrUser();})
    .catch(e=>toast('❌ '+e.message,'err'));
}
