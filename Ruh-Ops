function toggleCustomAssign(){
  const isOther=v('t-assign')==='Other (free text)';
  g('t-custom').style.display=isOther?'block':'none';
  if(!isOther)g('t-custom').value='';
}
function saveTask(){
  const title=v('t-title').trim();if(!title){toast('Please enter a task title','err');return}
  const assign=v('t-assign')==='Other (free text)'?v('t-custom').trim():v('t-assign');
  const rec={
    title,assign,priority:v('t-priority'),due:v('t-due'),
    category:v('t-cat'),status:v('t-status'),notes:v('t-notes'),
    done:false,by:currentUser,createdAt:nowISO()
  };
  db.ref('tasks').push(rec).then(()=>toast('✅ Task added')).catch(e=>toast('❌ '+e.message,'err'));
  clrTask();
}
function clrTask(){['t-title','t-custom','t-notes'].forEach(id=>g(id)&&(g(id).value=''));g('t-status').value='Pending'}
function toggleTask(key,done){
  db.ref('tasks/'+key).update({done:!done,status:!done?'Done':'Pending'});
}
function renderTasks(){
  const fs=v('tf-status'),fa=v('tf-assign'),fp=v('tf-priority');
  let tasks=allData.tasks.filter(t=>(!fs||t.status===fs)&&(!fa||t.assign===fa)&&(!fp||t.priority===fp));
  tasks.sort((a,b)=>{const p={High:0,Medium:1,Low:2};return p[a.priority]-p[b.priority]});
  const el=g('task-list');if(!el)return;
  if(!tasks.length){el.innerHTML='<div class="empty-state"><div class="ei">✅</div>No tasks match filter</div>';return}
  const sb={Pending:'b-gold',Done:'b-green','In Progress':'b-blue'};
  const pc={High:'ph',Medium:'pm',Low:'pl'};
  el.innerHTML=tasks.map(t=>`<div class="task-item">
    <input type="checkbox" class="task-cb" ${t.done?'checked':''} onchange="toggleTask('${t._key}',${t.done})">
    <div class="task-body">
      <div class="task-title ${t.done?'done':''}">${t.title}</div>
      <div class="task-meta">
        <span><span class="p-dot ${pc[t.priority]}"></span>${t.priority}</span>
        <span>👤 ${t.assign}</span>
        <span>📁 ${t.category}</span>
        ${t.due?`<span>📅 ${t.due}</span>`:''}
        <span class="badge ${sb[t.status]||'b-gray'}">${t.status}</span>
        <span style="font-family:var(--mono);font-size:10px;color:var(--muted)">by ${t.by}</span>
      </div>
      ${t.notes?`<div class="task-note">${t.notes}</div>`:''}
    </div>
    ${canDelete(t)?`<button class="btn btn-danger btn-sm" style="flex-shrink:0" onclick="delRec('tasks','${t._key}')">🗑</button>`:''}
  </div>`).join('');
}
function updateTaskBadge(){
  const open=allData.tasks.filter(t=>t.status!=='Done').length;
  const b=g('task-badge');if(!b)return;
  if(open>0){b.textContent=open;b.style.display='inline'}else b.style.display='none';
}

