<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RUH Station Manager</title>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0a1628;--navy2:#112240;--navy3:#1a3a5c;
  --accent:#00b4d8;--accent2:#0077b6;--gold:#f4a261;
  --success:#2ecc71;--danger:#e74c3c;--warning:#f39c12;--info:#3498db;
  --bg:#f0f4f8;--card:#ffffff;--border:#dde3eb;
  --text:#0d1b2a;--muted:#5a6a7a;--light:#f8fafc;
  --font:'IBM Plex Sans',sans-serif;--mono:'IBM Plex Mono',monospace;
}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:14px;min-height:100vh}

/* ═══ AUTH ═══ */
#auth-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;
  background:var(--navy);position:relative;overflow:hidden}
#auth-screen::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 30% 50%,rgba(0,180,216,.12) 0%,transparent 60%),
             radial-gradient(ellipse at 70% 20%,rgba(0,119,182,.1) 0%,transparent 50%);pointer-events:none}
.auth-grid{position:absolute;inset:0;
  background-image:linear-gradient(rgba(0,180,216,.04) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(0,180,216,.04) 1px,transparent 1px);
  background-size:40px 40px;pointer-events:none}
.auth-box{background:rgba(255,255,255,.04);border:1px solid rgba(0,180,216,.2);
  border-radius:16px;padding:2.5rem 2rem;width:380px;position:relative;backdrop-filter:blur(20px)}
.auth-header{text-align:center;margin-bottom:2rem}
.auth-logo{display:inline-flex;align-items:center;gap:10px;margin-bottom:.75rem}
.auth-logo-icon{width:42px;height:42px;background:linear-gradient(135deg,var(--accent),var(--accent2));
  border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px}
.auth-title{font-size:22px;font-weight:700;color:#fff;letter-spacing:-.3px}
.auth-sub{font-size:12px;color:rgba(255,255,255,.4);margin-top:4px;font-family:var(--mono);letter-spacing:1px}
.auth-field{margin-bottom:1rem}
.auth-field label{display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.5);
  text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
.auth-field input{width:100%;padding:11px 14px;background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.12);border-radius:8px;color:#fff;font-size:14px;
  font-family:var(--font);outline:none;transition:all .2s}
.auth-field input:focus{border-color:var(--accent);background:rgba(0,180,216,.08);box-shadow:0 0 0 3px rgba(0,180,216,.15)}
.auth-field input::placeholder{color:rgba(255,255,255,.25)}
.btn-auth{width:100%;padding:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));
  border:none;border-radius:8px;color:#fff;font-size:14px;font-weight:600;cursor:pointer;
  font-family:var(--font);letter-spacing:.3px;transition:all .2s;margin-top:.5rem}
.btn-auth:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,180,216,.4)}
.btn-auth:disabled{opacity:.5;cursor:not-allowed;transform:none}
.auth-err{color:#ff6b6b;font-size:12px;text-align:center;margin-top:.75rem;display:none;
  background:rgba(231,76,60,.1);border:1px solid rgba(231,76,60,.3);border-radius:6px;padding:8px}
.auth-badge{text-align:center;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.08)}
.auth-badge p{font-size:11px;color:rgba(255,255,255,.25);font-family:var(--mono)}

/* ═══ SETUP SCREEN ═══ */
#setup-screen{display:none;align-items:center;justify-content:center;min-height:100vh;
  background:var(--navy);flex-direction:column;gap:1.5rem;padding:2rem}
.setup-box{background:rgba(255,255,255,.05);border:1px solid rgba(0,180,216,.3);border-radius:16px;
  padding:2rem;width:100%;max-width:560px;color:#fff}
.setup-box h2{font-size:18px;margin-bottom:.5rem;color:var(--accent)}
.setup-box p{font-size:13px;color:rgba(255,255,255,.6);margin-bottom:1.5rem;line-height:1.6}
.setup-field{margin-bottom:1rem}
.setup-field label{display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.5);
  text-transform:uppercase;letter-spacing:.8px;margin-bottom:5px}
.setup-field input{width:100%;padding:10px 14px;background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.15);border-radius:8px;color:#fff;font-size:13px;
  font-family:var(--mono);outline:none;transition:border .2s}
.setup-field input:focus{border-color:var(--accent)}
.setup-steps{display:flex;flex-direction:column;gap:.5rem;font-size:12px;color:rgba(255,255,255,.5);
  background:rgba(0,0,0,.2);border-radius:8px;padding:1rem}
.setup-steps li{padding:3px 0;list-style:none;padding-left:1.2rem;position:relative}
.setup-steps li::before{content:'→';position:absolute;left:0;color:var(--accent);opacity:.7}
.setup-note{font-size:11px;color:rgba(255,255,255,.3);text-align:center;font-family:var(--mono)}

/* ═══ APP LAYOUT ═══ */
#app{display:none;min-height:100vh}
.sidebar{width:230px;background:var(--navy);min-height:100vh;position:fixed;left:0;top:0;z-index:100;
  display:flex;flex-direction:column;border-right:1px solid rgba(255,255,255,.06)}
.sidebar-brand{padding:1.25rem 1.2rem 1rem;border-bottom:1px solid rgba(255,255,255,.07)}
.brand-row{display:flex;align-items:center;gap:10px}
.brand-icon{width:34px;height:34px;background:linear-gradient(135deg,var(--accent),var(--accent2));
  border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.brand-text h2{color:#fff;font-size:14px;font-weight:700;letter-spacing:-.2px}
.brand-text p{color:rgba(255,255,255,.35);font-size:10px;font-family:var(--mono);margin-top:1px}
.user-pill{margin:10px 1.2rem 0;background:rgba(0,180,216,.1);border:1px solid rgba(0,180,216,.2);
  border-radius:20px;padding:5px 10px;display:flex;align-items:center;gap:6px}
.user-pill-dot{width:6px;height:6px;border-radius:50%;background:var(--success);flex-shrink:0;
  box-shadow:0 0 6px var(--success)}
.user-pill span{font-size:11px;color:rgba(255,255,255,.7);font-family:var(--mono);font-weight:500}
.user-pill .role-tag{margin-left:auto;font-size:9px;padding:1px 6px;border-radius:10px;font-weight:600;letter-spacing:.5px}
.role-admin{background:rgba(244,162,97,.2);color:#f4a261}
.role-user{background:rgba(0,180,216,.15);color:var(--accent)}
.nav-group{padding:.5rem .8rem .1rem;font-size:9px;color:rgba(255,255,255,.3);
  text-transform:uppercase;letter-spacing:1px;font-weight:600;margin-top:.5rem}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 1.2rem;color:rgba(255,255,255,.55);
  cursor:pointer;font-size:13px;transition:all .15s;border-left:2px solid transparent;position:relative}
.nav-item:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.85)}
.nav-item.active{background:rgba(0,180,216,.1);color:#fff;border-left-color:var(--accent)}
.nav-icon{font-size:15px;width:18px;text-align:center;opacity:.8}
.nav-badge{margin-left:auto;background:rgba(231,76,60,.25);color:#ff6b6b;font-size:10px;
  padding:1px 6px;border-radius:10px;font-weight:700}
.sidebar-bottom{margin-top:auto;padding:1rem 1.2rem;border-top:1px solid rgba(255,255,255,.07)}
.sync-status{display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.35);
  margin-bottom:.75rem;font-family:var(--mono)}
.sync-dot{width:6px;height:6px;border-radius:50%;background:var(--success)}
.sync-dot.offline{background:#e74c3c}
.logout-btn{width:100%;padding:8px;background:rgba(231,76,60,.1);border:1px solid rgba(231,76,60,.2);
  border-radius:7px;color:rgba(231,76,60,.8);font-size:12px;cursor:pointer;font-family:var(--font);
  font-weight:600;transition:all .15s}
.logout-btn:hover{background:rgba(231,76,60,.2);color:#e74c3c}

/* ═══ MAIN ═══ */
.main{margin-left:230px;padding:1.75rem 2rem;min-height:100vh}
.page{display:none}
.page.active{display:block}
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem}
.page-title{font-size:20px;font-weight:700;color:var(--text);letter-spacing:-.4px}
.page-sub{font-size:12px;color:var(--muted);margin-top:3px;font-family:var(--mono)}
.header-actions{display:flex;gap:.6rem;flex-wrap:wrap}

/* ═══ CARDS ═══ */
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem}
.card-title{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;
  letter-spacing:.7px;margin-bottom:1rem;display:flex;align-items:center;gap:6px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}

/* ═══ METRICS ═══ */
.metric{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.25rem;
  position:relative;overflow:hidden}
.metric::after{content:'';position:absolute;right:-10px;top:-10px;width:60px;height:60px;
  border-radius:50%;opacity:.06}
.metric.m-blue::after{background:var(--info)}
.metric.m-green::after{background:var(--success)}
.metric.m-red::after{background:var(--danger)}
.metric.m-gold::after{background:var(--gold)}
.metric-label{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;
  letter-spacing:.7px;margin-bottom:.5rem}
.metric-val{font-size:24px;font-weight:700;letter-spacing:-.5px;font-family:var(--mono)}
.metric-val.pos{color:var(--success)}
.metric-val.neg{color:var(--danger)}
.metric-val.blue{color:var(--accent2)}
.metric-val.gold{color:var(--gold)}
.metric-sub{font-size:11px;color:var(--muted);margin-top:3px}

/* ═══ FORMS ═══ */
.form-group{margin-bottom:.9rem}
.form-label{display:block;font-size:11px;font-weight:600;color:var(--muted);
  text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px}
.form-input,.form-select,.form-textarea{width:100%;padding:9px 12px;border:1px solid var(--border);
  border-radius:8px;font-size:13px;background:#fff;color:var(--text);outline:none;
  font-family:var(--font);transition:border .15s,box-shadow .15s}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--accent2);
  box-shadow:0 0 0 3px rgba(0,119,182,.1)}
.form-textarea{resize:vertical;min-height:70px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
.form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.9rem}
.sec-head{font-size:12px;font-weight:700;color:var(--navy3);margin:1.25rem 0 .75rem;
  padding:.4rem .75rem;background:linear-gradient(90deg,rgba(0,119,182,.07),transparent);
  border-left:3px solid var(--accent2);border-radius:0 6px 6px 0;
  display:flex;align-items:center;gap:6px}

/* ═══ BUTTONS ═══ */
.btn{padding:9px 16px;border-radius:8px;font-size:13px;cursor:pointer;font-weight:600;
  border:none;transition:all .15s;font-family:var(--font);display:inline-flex;align-items:center;gap:5px}
.btn-primary{background:var(--navy2);color:#fff}
.btn-primary:hover{background:var(--navy3)}
.btn-accent{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff}
.btn-accent:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,119,182,.3)}
.btn-danger{background:rgba(231,76,60,.1);color:var(--danger);border:1px solid rgba(231,76,60,.2)}
.btn-danger:hover{background:rgba(231,76,60,.2)}
.btn-success{background:rgba(46,204,113,.1);color:var(--success);border:1px solid rgba(46,204,113,.2)}
.btn-success:hover{background:rgba(46,204,113,.2)}
.btn-ghost{background:#f3f4f6;color:#374151;border:1px solid #d1d5db}
.btn-ghost:hover{background:#e5e7eb}
.btn-sm{padding:6px 12px;font-size:12px}
.btn-group{display:flex;gap:.6rem;margin-top:1.25rem;flex-wrap:wrap}

/* ═══ TABLES ═══ */
.tbl-wrap{overflow-x:auto}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{background:#f8f9fb;padding:8px 12px;text-align:left;font-size:10px;
  color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:700;
  border-bottom:2px solid var(--border);white-space:nowrap}
.data-table td{padding:9px 12px;border-bottom:1px solid #f0f2f5;vertical-align:middle}
.data-table tr:hover td{background:#fafbfd}
.data-table .pos{color:var(--success);font-weight:600;font-family:var(--mono)}
.data-table .neg{color:var(--danger);font-weight:600;font-family:var(--mono)}
.data-table .num{font-family:var(--mono)}

/* ═══ BADGES ═══ */
.badge{padding:2px 8px;border-radius:12px;font-size:10px;font-weight:700;letter-spacing:.3px}
.b-green{background:#dcfce7;color:#166534}
.b-red{background:#fee2e2;color:#991b1b}
.b-blue{background:#dbeafe;color:#1e40af}
.b-gold{background:#fef3c7;color:#92400e}
.b-gray{background:#f3f4f6;color:#374151}
.b-purple{background:#f3e8ff;color:#6b21a8}
.b-teal{background:#ccfbf1;color:#065f46}

/* ═══ TABS ═══ */
.tabs{display:flex;gap:0;border-bottom:2px solid var(--border);margin-bottom:1.5rem}
.tab{padding:8px 16px;cursor:pointer;font-size:13px;font-weight:600;color:var(--muted);
  border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s}
.tab:hover{color:var(--text)}
.tab.active{color:var(--accent2);border-bottom-color:var(--accent2)}
.tab-pane{display:none}
.tab-pane.active{display:block}

/* ═══ ALERTS ═══ */
.alert{padding:10px 14px;border-radius:8px;font-size:12px;font-weight:500;margin-bottom:.75rem;
  display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.a-warn{background:#fef3c7;color:#92400e;border-left:3px solid #f59e0b}
.a-danger{background:#fee2e2;color:#991b1b;border-left:3px solid #ef4444}
.a-info{background:#dbeafe;color:#1e40af;border-left:3px solid #3b82f6}
.a-success{background:#dcfce7;color:#166534;border-left:3px solid #22c55e}

/* ═══ TASKS ═══ */
.task-item{background:#fff;border:1px solid var(--border);border-radius:10px;padding:.9rem 1rem;
  margin-bottom:.6rem;display:flex;gap:10px;align-items:flex-start;transition:box-shadow .15s}
.task-item:hover{box-shadow:0 2px 8px rgba(0,0,0,.06)}
.task-cb{margin-top:2px;accent-color:var(--accent2);width:15px;height:15px;cursor:pointer;flex-shrink:0}
.task-body{flex:1}
.task-title{font-weight:600;font-size:13px;color:var(--text)}
.task-title.done{text-decoration:line-through;color:var(--muted)}
.task-meta{font-size:11px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap;margin-top:3px}
.task-note{font-size:11px;color:var(--muted);margin-top:4px;font-style:italic}
.p-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:3px;vertical-align:middle}
.ph{background:#ef4444}.pm{background:#f59e0b}.pl{background:#22c55e}

/* ═══ USER MGMT ═══ */
.user-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:1rem;
  display:flex;align-items:center;gap:12px;margin-bottom:.6rem}
.user-avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-weight:700;font-size:14px;flex-shrink:0;font-family:var(--mono)}
.ua-admin{background:rgba(244,162,97,.15);color:#c05c00}
.ua-user{background:rgba(0,119,182,.1);color:var(--accent2)}
.user-info{flex:1}
.user-info h4{font-size:13px;font-weight:700;font-family:var(--mono)}
.user-info p{font-size:11px;color:var(--muted);margin-top:2px}
.user-access{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}

/* ═══ TOAST ═══ */
.toast{position:fixed;bottom:2rem;right:2rem;z-index:9999;padding:10px 18px;border-radius:9px;
  font-size:13px;font-weight:600;display:none;box-shadow:0 6px 24px rgba(0,0,0,.15);
  animation:slideUp .3s ease}
.toast-ok{background:#0a2818;color:#2ecc71;border:1px solid rgba(46,204,113,.3)}
.toast-err{background:#2a0a0a;color:#e74c3c;border:1px solid rgba(231,76,60,.3)}
@keyframes slideUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ═══ LOADING ═══ */
.loading-overlay{position:fixed;inset:0;background:rgba(10,22,40,.95);z-index:9999;
  display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem}
.spinner{width:36px;height:36px;border:3px solid rgba(0,180,216,.2);border-top-color:var(--accent);
  border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-overlay p{color:rgba(255,255,255,.5);font-size:13px;font-family:var(--mono)}

/* MISC */
.divider{height:1px;background:var(--border);margin:1.25rem 0}
.empty-state{text-align:center;padding:2.5rem;color:var(--muted);font-size:13px}
.empty-state .ei{font-size:32px;margin-bottom:.5rem;opacity:.4}
.pnl-box{background:#f8f9fb;border-radius:10px;padding:1rem;margin-top:1rem}
.pnl-row{display:flex;justify-content:space-between;padding:4px 0;font-size:13px}
.pnl-row.total{border-top:1px solid var(--border);margin-top:6px;padding-top:10px;font-weight:700;font-size:14px}
.fare-bar{padding:6px 10px;border-radius:6px;font-size:11px;font-weight:700;margin-top:4px;font-family:var(--mono)}
.fb-below{background:#dcfce7;color:#166534}
.fb-above{background:#fee2e2;color:#991b1b}
.fb-equal{background:#dbeafe;color:#1e40af}
.conn-err{background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.25);border-radius:10px;
  padding:1.5rem;text-align:center;color:var(--danger);font-size:13px}
</style>
</head>
<body>

<!-- LOADING -->
<div class="loading-overlay" id="loading">
  <div class="spinner"></div>
  <p>Connecting to server...</p>
</div>

<!-- SETUP SCREEN -->
<div id="setup-screen">
  <div class="setup-box">
    <h2>⚙️ First-Time Firebase Setup</h2>
    <p>This app uses Firebase for real-time sync across all systems. You only need to do this once. Enter your Firebase project credentials below — they will be saved in this HTML file.</p>
    <ul class="setup-steps">
      <li>Go to <strong>console.firebase.google.com</strong> and create a free project</li>
      <li>Go to Project Settings → Add Web App → copy the firebaseConfig values</li>
      <li>In Realtime Database, create a database and set rules to authenticated-only</li>
      <li>In Realtime Database → Rules, paste: <code style="background:rgba(0,0,0,.3);padding:2px 6px;border-radius:4px">{"rules":{".read":"true",".write":"true"}}</code> (then tighten later)</li>
      <li>Paste your config values below and click Save</li>
    </ul>
    <div style="margin-top:1.5rem">
      <div class="setup-field"><label>API Key</label><input id="s-apikey" placeholder="AIzaSy..."></div>
      <div class="setup-field"><label>Auth Domain</label><input id="s-authdomain" placeholder="your-project.firebaseapp.com"></div>
      <div class="setup-field"><label>Database URL</label><input id="s-dburl" placeholder="https://your-project-default-rtdb.firebaseio.com"></div>
      <div class="setup-field"><label>Project ID</label><input id="s-projectid" placeholder="your-project-id"></div>
      <div class="setup-field"><label>App ID</label><input id="s-appid" placeholder="1:123456:web:abc123"></div>
    </div>
    <button class="btn-auth" onclick="saveFirebaseConfig()" style="margin-top:1rem">💾 Save Configuration & Connect</button>
    <p class="setup-note" style="margin-top:1rem">These credentials are stored locally in your browser. Share the configured HTML file with all users.</p>
  </div>
</div>

<!-- AUTH SCREEN -->
<div id="auth-screen" style="display:none">
  <div class="auth-grid"></div>
  <div class="auth-box">
    <div class="auth-header">
      <div class="auth-logo">
