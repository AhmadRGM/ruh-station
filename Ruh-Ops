function liveFareAlert(){
  const pia=n('cf-pia');const el=g('cf-live-alerts');if(!el)return;
  if(!pia){el.innerHTML='';return}
  const comp=[
    {n:'Saudi Airlines',v:n('cf-sv')},{n:'Flynas',v:n('cf-xq')},{n:'Flyadeal',v:n('cf-f3')},
    {n:'Airblue',v:n('cf-pa')},{n:'AirSial',v:n('cf-airsial')},{n:'Fly Jinnah',v:n('cf-9p')}
  ];
  let html='';
  comp.filter(c=>c.v).forEach(c=>{
    const d=c.v-pia,pct=((Math.abs(d)/pia)*100).toFixed(1);
    const arrow = d<0 ? '⬇' : (d>0 ? '⬆' : '=');
    const cls   = d<0 ? 'fb-below' : (d>0 ? 'fb-above' : 'fb-equal');
    const label = d<0 ? pct+'% below PIA' : (d>0 ? pct+'% above PIA' : 'Same as PIA');
    html += '<div class="fare-bar '+cls+'">'+arrow+' '+c.n+': SAR '+c.v.toFixed(0)+' \u2014 '+label+'</div>';
  });
  el.innerHTML=html;
}
