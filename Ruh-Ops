// ═══════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════
const g=id=>document.getElementById(id);
const v=id=>g(id)?g(id).value:'';
const n=id=>parseFloat(g(id)?g(id).value:0)||0;
const hide=id=>{if(g(id))g(id).style.display='none'};
const show=(id,d='block')=>{if(g(id))g(id).style.display=d};
const SECTORS=['ISB','LHE','MUX','SKT','PEW','KHI','LYP'];
const today=()=>new Date().toISOString().split('T')[0];
