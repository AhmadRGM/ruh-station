function toast(msg,type='ok'){
  const t=g('toast');
  t.textContent=msg;
  t.className='toast '+(type==='ok'?'toast-ok':'toast-err');
  t.style.display='block';
  setTimeout(()=>t.style.display='none',2400);
}

// ═══════════════════════════════════════════════
// SIMPLE HASH (for password storage — not cryptographic)
// ═══════════════════════════════════════════════
function simpleHash(str){
  var hash=0;
  for(var i=0;i<str.length;i++){
    var ch=str.charCodeAt(i);
    hash=((hash<<5)-hash)+ch;
    hash=hash&hash;
  }
  return 'h'+Math.abs(hash).toString(36);
}

// ═══════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════
function doLogin(){
  const uid=g('login-user').value.trim().toLowerCase();
  const pass=g('login-pass').value;
  if(!uid||!pass){showAuthErr('Please enter User ID and password');return;}
  g('login-btn').disabled=true;g('login-btn').textContent='Signing in...';
  show('loading');
  db.ref('users/'+uid).once('value').then(function(snap){
    const user=snap.val();
    if(!user||!user.active){
      hideLoading();showAuthErr('User not found or access revoked.');
      g('login-btn').disabled=false;g('login-btn').textContent='Sign In →';return;
    }
    if(user.pwHash!==simpleHash(pass)){
      hideLoading();showAuthErr('Incorrect password.');
      g('login-btn').disabled=false;g('login-btn').textContent='Sign In →';return;
    }
    currentUser=uid;currentRole=user.role||'user';
    currentPerms=user.perms||{finance:true,competitors:true,tasks:true};
    g('pill-user').textContent=uid;
    g('pill-role').textContent=currentRole==='admin'?'Admin':'User';
    g('pill-role').className='role-tag '+(currentRole==='admin'?'role-admin':'role-user');
    applyRoleUI();
    hide('auth-screen');show('app');
    hideLoading();
    const firstPage=currentRole==='admin'?'dashboard':'finance';
    const firstNav=g('nav-'+(currentRole==='admin'?'dashboard':'finance'));
    showPage(firstPage,firstNav);
    subscribeAllData();
  }).catch(function(err){
    hideLoading();showAuthErr('Connection error: '+err.message);
    g('login-btn').disabled=false;g('login-btn').textContent='Sign In →';
  });
}

function hideLoading(){hide('loading')}
function showAuthErr(msg){g('auth-err').textContent=msg;show('auth-err')}

function doLogout(){
  currentUser=null;currentRole=null;currentPerms={};
  hide('app');show('auth-screen');
  g('login-user').value='';g('login-pass').value='';
  hide('auth-err');
  allData={finance:[],flightecon:[],competitors:[],tasks:[]};
  try{db.ref('finance').off();db.ref('flightecon').off();db.ref('competitors').off();db.ref('tasks').off();db.ref('users').off();}catch(e){}
}

function applyRoleUI(){
  if(currentRole==='admin'){
    show('nav-dashboard');show('nav-flightecon');show('nav-analysis');show('nav-users');show('ng-admin');
  } else {
    hide('nav-dashboard');
    if(!currentPerms.flightecon)hide('nav-flightecon');
    if(!currentPerms.finance)hide('nav-finance');
    if(!currentPerms.competitors)hide('nav-competitors');
    if(!currentPerms.tasks)hide('nav-tasks');
    hide('nav-analysis');hide('nav-users');hide('ng-admin');
  }
  if(currentRole==='admin'){
    g('fin-export-btn').innerHTML='<button class="btn btn-success btn-sm" onclick="exportExcel(\'finance\')">⬇ Export Excel</button>';
  }
}

// ═══════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════
function showPage(pg,navEl){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const pageEl=g('page-'+pg);
  if(pageEl)pageEl.classList.add('active');
  if(navEl)navEl.classList.add('active');
  if(pg==='dashboard')refreshDashboard();
  if(pg==='analysis'){populateAnSectors();runAnalysis();}
  if(pg==='users')renderUserList();
  if(pg==='finance')renderFinTable();
  if(pg==='flightecon'){renderFeTable();populateFeSectorFilter();}
  if(pg==='competitors'){renderCfTable();populateCfSectorFilter();}
  if(pg==='tasks')renderTasks();
}

function swTab(form,pane,el){
  el.closest('.tabs').querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  const prefix=form+'-';
  document.querySelectorAll('[id^="'+prefix+'"]').forEach(p=>{if(p.classList.contains('tab-pane'))p.classList.remove('active')});
  g(prefix+pane).classList.add('active');
  if(form==='fin'&&pane==='records')renderFinTable();
  if(form==='fe'&&pane==='records'){renderFeTable();populateFeSectorFilter();}
  if(form==='cf'&&pane==='records'){renderCfTable();populateCfSectorFilter();}
}

// ═══════════════════════════════════════════════
// REAL-TIME SUBSCRIPTIONS
// ═══════════════════════════════════════════════
function subscribeAllData(){
  db.ref('finance').on('value',snap=>{
    allData.finance=objToArr(snap.val());
    renderFinTable();refreshDashboard();
  });
  db.ref('flightecon').on('value',snap=>{
    allData.flightecon=objToArr(snap.val());
    renderFeTable();refreshDashboard();
  });
  db.ref('competitors').on('value',snap=>{
    allData.competitors=objToArr(snap.val());
    renderCfTable();refreshDashboard();populateCfSectorFilter();populateAnSectors();
  });
  db.ref('tasks').on('value',snap=>{
    allData.tasks=objToArr(snap.val());
    renderTasks();updateTaskBadge();refreshDashboard();
  });
  db.ref('users').on('value',snap=>{
    usersMap=snap.val()||{};
    renderUserList();
  });
  g('sync-dot').classList.remove('offline');
  g('sync-label').textContent='Live sync';
}

function objToArr(obj){
  if(!obj)return[];
  return Object.entries(obj).map(([k,v])=>({...v,_key:k})).sort((a,b)=>(b.createdAt||'').localeCompare(a.createdAt||''));
}

