    date:v('cf-date'),dir:v('cf-dir'),sector:v('cf-sector'),
    pia:n('cf-pia'),sv:n('cf-sv'),xq:n('cf-xq'),f3:n('cf-f3'),pa:n('cf-pa'),airsial:n('cf-airsial'),p9:n('cf-9p'),
    lpia:g('cf-lpia').value,lsv:g('cf-lsv').value,lxq:g('cf-lxq').value,
    lf3:g('cf-lf3').value,lpa:g('cf-lpa').value,lai:g('cf-lai').value,l9p:g('cf-l9p').value,
